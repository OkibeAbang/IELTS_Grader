# Copy to .env for local dev. In production (Render), set these as dashboard
# environment variables instead — never commit real values.

# Required
GEMINI_API_KEY=your-api-key-here
JWT_SECRET=

# Required in production — hosted database (Turso, libSQL/SQLite-compatible).
# Local dev needs neither: db.js falls back to a local file
# (./data/ielts.db) when TURSO_DATABASE_URL is unset, so `npm run dev` just
# works with no account. Render's free tier has no persistent disk, so a
# local-file DB in production gets wiped on every sleep/redeploy — see
# REMINDERS.md. Get both from the Turso dashboard after creating a database.
# TURSO_DATABASE_URL=libsql://your-db-name.turso.io
# TURSO_AUTH_TOKEN=

# Required in production — audio storage (Cloudflare R2, S3-compatible).
# Local dev needs none of these: audioStorage.js falls back to local disk
# (./uploads) when R2_ACCOUNT_ID is unset. In production, unset R2 vars mean
# recordings get wiped the same way the DB does without Turso — see above.
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=

# Exact origin of the deployed frontend, no trailing slash (e.g. https://your-app.vercel.app).
# Required in production for CORS + cross-origin cookies to work.
CLIENT_ORIGIN=http://localhost:3000

# Render sets PORT and NODE_ENV automatically — only needed for local dev.
PORT=4000
# NODE_ENV=production

# Optional — free-tier fallback for essay/section grading + prompt generation
# when Gemini hits a quota/rate-limit or capacity error (tried before Claude
# below, since it's actually free — see REMINDERS.md/BILLING.md). No card
# required: console.groq.com. Speaking grading has no fallback (no audio input
# support on either fallback provider).
# GROQ_API_KEY=

# Optional — paid fallback, tried only if Groq is unset or also fails.
# ANTHROPIC_API_KEY=

# Optional — Google Sign-In. Leave unset to keep password auth only.
# GOOGLE_CLIENT_ID=

# Optional — outbound email (verification / password reset). Leave SMTP_HOST
# unset to have these links print to the server console/logs instead of
# actually sending.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# EMAIL_FROM=no-reply@yourdomain.com

# JWT_EXPIRES_IN=7d

# Optional, off by default — real-time voice conversation for Part 1
# (server/src/liveSpeaking.js). Uses a preview Gemini model and costs
# materially more per session than normal grading. See REMINDERS.md before
# turning this on in production.
# ENABLE_LIVE_VOICE=true

# Admin panel login (username/password) is NOT set here — it lives in a
# separate gitignored `secret` file (server/secret), loaded via
# dotenv.config({ path: "secret" }) in index.js. In production, set
# ADMIN_USERNAME and ADMIN_PASSWORD as Render dashboard env vars instead,
# since the `secret` file itself never leaves this machine.
